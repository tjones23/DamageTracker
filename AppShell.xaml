<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="DamageTracker.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:DamageTracker.Views"
    Title="DamageTracker">

    <TabBar>
        <ShellContent Title="Map" Icon="tab_map.png"
                      ContentTemplate="{DataTemplate views:MapPage}" Route="map" />
        <ShellContent Title="Reports" Icon="tab_reports.png"
                      ContentTemplate="{DataTemplate views:ReportsPage}" Route="reports" />
        <ShellContent Title="Alerts" Icon="tab_warnings.png"
                      ContentTemplate="{DataTemplate views:AlertsPage}" Route="warnings" />
        <ShellContent Title="Saved" Icon="tab_saved.png"
                      ContentTemplate="{DataTemplate views:SavedLocationsPage}" Route="saved" />
    </TabBar>

</Shell>

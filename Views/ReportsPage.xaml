<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="DamageTracker.Views.ReportsPage"
    x:Name="Page"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:DamageTracker.Controls"
    xmlns:models="clr-namespace:DamageTracker.Models"
    Shell.NavBarIsVisible="False"
    Title="">

    <Grid>
        <RefreshView IsRefreshing="{Binding IsBusy}" Command="{Binding RefreshCommand}">
            <CollectionView ItemsSource="{Binding Reports}" SelectionMode="None">
                <CollectionView.Header>
                    <Grid Padding="12,10" Margin="0,48,0,0" ColumnDefinitions="*,*,*" BindingContext="{Binding Source={x:Reference Page}, Path=BindingContext}">
                        <VerticalStackLayout Grid.Column="0" HorizontalOptions="Center">
                            <Label Text="🌪️" HorizontalOptions="Center" />
                            <Label Text="{Binding TornadoCount}" FontAttributes="Bold" FontSize="17" HorizontalOptions="Center" />
                            <Label Text="Tornado" FontSize="11" TextColor="Gray" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center">
                            <Label Text="💨" HorizontalOptions="Center" />
                            <Label Text="{Binding WindCount}" FontAttributes="Bold" FontSize="17" HorizontalOptions="Center" />
                            <Label Text="Wind" FontSize="11" TextColor="Gray" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="2" HorizontalOptions="Center">
                            <Label Text="🧊" HorizontalOptions="Center" />
                            <Label Text="{Binding HailCount}" FontAttributes="Bold" FontSize="17" HorizontalOptions="Center" />
                            <Label Text="Hail" FontSize="11" TextColor="Gray" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </Grid>
                </CollectionView.Header>
                <CollectionView.EmptyView>
                    <VerticalStackLayout Padding="24" Spacing="6" VerticalOptions="Center">
                        <Label Text="No reports" FontSize="18" FontAttributes="Bold" HorizontalOptions="Center" />
                        <Label Text="{Binding ErrorMessage}" FontSize="13" TextColor="Gray" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:StormReport">
                        <Grid Padding="14,8" ColumnDefinitions="34,*,Auto" ColumnSpacing="10">
                            <Label Grid.Column="0" Text="{Binding Glyph}" FontSize="22" VerticalOptions="Center" />
                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                <Label Text="{Binding Title}" FontAttributes="Bold" FontSize="16" />
                                <Label Text="{Binding Subtitle}" FontSize="13" TextColor="Gray" />
                                <Label Text="{Binding Comments}" FontSize="12" TextColor="Gray"
                                       MaxLines="2" LineBreakMode="TailTruncation" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="2" HorizontalOptions="End">
                                <Label Text="{Binding DayLabel}" FontSize="12" TextColor="Gray" HorizontalTextAlignment="End" />
                                <Label Text="{Binding TimeLabel}" FontSize="11" TextColor="Silver" HorizontalTextAlignment="End" />
                            </VerticalStackLayout>
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding Source={x:Reference Page}, Path=BindingContext.SelectCommand}"
                                    CommandParameter="{Binding .}" />
                            </Grid.GestureRecognizers>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

        <ImageButton Source="{AppThemeBinding Light=menu.png, Dark=menu_dark.png}" Command="{Binding OpenFiltersCommand}"
                     WidthRequest="42" HeightRequest="42" CornerRadius="21" Padding="9"
                     BackgroundColor="{AppThemeBinding Light=#F2FFFFFF, Dark=#3A3A3C}"
                     HorizontalOptions="End" VerticalOptions="Start" Margin="0,8,12,0">
            <ImageButton.Shadow>
                <Shadow Brush="Black" Offset="0,2" Radius="6" Opacity="0.3" />
            </ImageButton.Shadow>
        </ImageButton>
    </Grid>
</ContentPage>

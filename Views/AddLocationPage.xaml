<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="DamageTracker.Views.AddLocationPage"
    x:Name="Page"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:DamageTracker.ViewModels"
    Title="Add Location">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Cancel" Command="{Binding CancelCommand}" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto,Auto,Auto,*" Padding="12" RowSpacing="8">
        <Button Grid.Row="0" Text="📍 Use current location" Command="{Binding UseCurrentCommand}"
                IsVisible="{Binding HasCurrentLocation}" />

        <SearchBar Grid.Row="1" Text="{Binding Query}" Placeholder="City, address, ZIP…"
                   SearchCommand="{Binding SearchCommand}" />

        <ActivityIndicator Grid.Row="2" IsRunning="{Binding IsSearching}" IsVisible="{Binding IsSearching}" />

        <CollectionView Grid.Row="3" ItemsSource="{Binding Results}" SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:GeocodeResult">
                    <Grid Padding="6,12">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="{Binding Name}" FontSize="16" />
                            <Label Text="{Binding Subtitle}" FontSize="12" TextColor="Gray" />
                        </VerticalStackLayout>
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding Source={x:Reference Page}, Path=BindingContext.SelectCommand}"
                                CommandParameter="{Binding .}" />
                        </Grid.GestureRecognizers>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>

<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="DamageTracker.Views.SavedLocationsPage"
    x:Name="Page"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:DamageTracker.ViewModels"
    Shell.NavBarIsVisible="False"
    Title="">

    <Grid>
        <VerticalStackLayout IsVisible="{Binding IsEmpty}" Padding="28" Spacing="12" VerticalOptions="Center">
            <Label Text="No saved locations" FontSize="18" FontAttributes="Bold" HorizontalOptions="Center" />
            <Label Text="Save your home, work, or family addresses to keep an eye on storm damage there."
                   FontSize="14" TextColor="Gray" HorizontalTextAlignment="Center" />
            <Button Text="Add a location" Command="{Binding AddCommand}" HorizontalOptions="Center" />
        </VerticalStackLayout>

        <CollectionView ItemsSource="{Binding Items}" SelectionMode="None" IsVisible="{Binding IsEmpty, Converter={x:Static vm:Not.Instance}}">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:SavedLocationItem">
                    <Grid Padding="16,12" RowDefinitions="Auto,Auto" RowSpacing="4">
                        <Label Grid.Row="0" Text="{Binding Name}" FontAttributes="Bold" FontSize="16" />
                        <Label Grid.Row="1" Text="{Binding Status}" TextColor="{Binding StatusColor}" FontSize="14" />
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding Source={x:Reference Page}, Path=BindingContext.SelectCommand}"
                                CommandParameter="{Binding .}" />
                        </Grid.GestureRecognizers>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <ImageButton Source="{AppThemeBinding Light=add.png, Dark=add_dark.png}" Command="{Binding AddCommand}"
                     WidthRequest="42" HeightRequest="42" CornerRadius="21" Padding="9"
                     BackgroundColor="{AppThemeBinding Light=#F2FFFFFF, Dark=#3A3A3C}"
                     HorizontalOptions="End" VerticalOptions="Start" Margin="0,8,12,0">
            <ImageButton.Shadow>
                <Shadow Brush="Black" Offset="0,2" Radius="6" Opacity="0.3" />
            </ImageButton.Shadow>
        </ImageButton>
    </Grid>
</ContentPage>

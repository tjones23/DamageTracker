<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>DamageTracker.Web</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.10" />
    <!-- Pinned above the 2.0.0 that Microsoft.AspNetCore.OpenApi pulls in
         transitively, which carries advisory GHSA-v5pm-xwqc-g5wc (high). -->
    <PackageReference Include="Microsoft.OpenApi" Version="2.11.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Shared models + NOAA/SPC services, also used by the MAUI app. -->
    <ProjectReference Include="..\DamageTracker.Core\DamageTracker.Core.csproj" />
  </ItemGroup>

</Project>

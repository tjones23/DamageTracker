@DamageTracker.Web_HostAddress = http://localhost:5263

GET {{DamageTracker.Web_HostAddress}}/health
Accept: application/json

###

# Active NWS warnings and watches.
GET {{DamageTracker.Web_HostAddress}}/api/alerts
Accept: application/json

###

# Confirmed SPC storm reports; days is clamped to 1-5 (default 3).
GET {{DamageTracker.Web_HostAddress}}/api/reports?days=3
Accept: application/json

###

# SPC convective outlook. kind = Categorical | Tornado | Wind | Hail.
# Categorical publishes days 1-3; the probabilistic kinds publish days 1-2.
GET {{DamageTracker.Web_HostAddress}}/api/outlook?day=1&kind=categorical
Accept: application/json

###

GET {{DamageTracker.Web_HostAddress}}/api/outlook?day=2&kind=tornado
Accept: application/json

###
